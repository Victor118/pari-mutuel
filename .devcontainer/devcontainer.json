{
  "name": "parimutuel",
  "image": "mcr.microsoft.com/devcontainers/go:1.24-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.testFlags": ["-v"],
        "go.lintTool": "golangci-lint",
        "go.testOnSave": true,
        "go.coverOnSave": true,
        "go.coverageDecorator": { "type": "gutter" }
      }
    }
  },
  "postCreateCommand": "go mod download"
}
